{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noisedh-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    // binding=ASSETS：src/index.ts 以 env.ASSETS.fetch 实现 /admin → /index.html 改写（非重定向）。
    // /admin、/admin/ 无资产命中 → 默认落入 Worker（无需 run_worker_first）；/ 与 /admin.js 资产直出。
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "navdata"
      // database_id 在 `wrangler d1 create navdata` 后回填（Task 12 手册步骤 2，见 admin/README.md）
    }
  ],
  // 非密配置按 spec §2.1 走 vars（明文入仓库无泄露面）；密仅 ADMIN_TOKEN/GITHUB_TOKEN/（可选）AI_* 三项 secret
  "vars": {
    "DEFAULT_TAXONOMY": "未分类",
    "FAVICON_TEMPLATE": "https://icons.duckduckgo.com/ip3/{host}.ico",
    "REPO": "sjmw/noisedh-nav"
  }
  // 区域路由（nav.wzyo.top/admin*、/api/*、/data*）在部署时创建，见 spec §2.2 与 README 手册步骤 5
}
